{
  "entities": {
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Trusted administrator marker document for RBAC.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator"
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN"],
          "maxLength": 32,
          "description": "Administrator privilege level"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "UserProfileDoc": {
      "title": "UserProfileDoc",
      "description": "Private user profile with display name, email, role, and active tenant.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Authenticated user email (restricted to owner/admin)"
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "OPS_MANAGER", "INVENTORY_ANALYST", "AUDITOR"],
          "maxLength": 32,
          "description": "Assigned RBAC role"
        },
        "activeTenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Currently selected tenant ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": ["uid", "name", "email", "role", "activeTenantId", "createdAt", "updatedAt"]
    },
    "TenantWorkspaceDoc": {
      "title": "TenantWorkspaceDoc",
      "description": "Multi-tenant supply chain workspace metadata document.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Tenant identifier"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Creator UID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Organization name"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9\\-]+$",
          "description": "Short tenant code"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Cloud region"
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5,
          "description": "Currency symbol"
        },
        "currencyLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "description": "Locale string for number formatting"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "MAINTENANCE"],
          "maxLength": 16,
          "description": "Workspace operational status"
        },
        "today": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "description": "Reference date YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "code",
        "region",
        "currencySymbol",
        "currencyLocale",
        "status",
        "today",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProductDoc": {
      "title": "ProductDoc",
      "description": "Product SKU catalogue and real-time stock record inside a tenant workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric product ID" },
        "productId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique document/product ID"
        },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[A-Za-z0-9\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "maxLength": 200 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "cost": { "type": "number" },
        "purchaseCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "stockStatus": {
          "type": "string",
          "enum": ["In Stock", "Low Stock", "Out of Stock"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "DISCONTINUED"]
        },
        "lead": { "type": "number" },
        "opening": { "type": "number" },
        "safety": { "type": "number" },
        "rop": { "type": "number" },
        "base": { "type": "number" },
        "sup": { "type": "number" },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "productId",
        "tenantId",
        "sku",
        "name",
        "productName",
        "category",
        "description",
        "unit",
        "cost",
        "purchaseCost",
        "sellingPrice",
        "currentStock",
        "lowStockThreshold",
        "stockStatus",
        "status",
        "lead",
        "opening",
        "safety",
        "rop",
        "base",
        "sup",
        "isSample",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryDoc": {
      "title": "InventoryDoc",
      "description": "Real-time inventory stock balance and warehouse location per product.",
      "type": "object",
      "properties": {
        "productId": { "type": "number" },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": { "type": "string", "minLength": 3, "maxLength": 20 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "quantityOnHand": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "safetyStock": { "type": "number" },
        "warehouseLocation": { "type": "string", "minLength": 1, "maxLength": 60 },
        "status": {
          "type": "string",
          "enum": ["In Stock", "Healthy Stock", "Low Stock", "Out of Stock"]
        },
        "isSample": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": [
        "productId",
        "tenantId",
        "sku",
        "productName",
        "quantityOnHand",
        "reorderLevel",
        "safetyStock",
        "warehouseLocation",
        "status",
        "isSample",
        "lastUpdated"
      ]
    },
    "SupplierDoc": {
      "title": "SupplierDoc",
      "description": "Supplier directory record inside a tenant workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "contactPerson": { "type": "string", "minLength": 1, "maxLength": 60 },
        "email": { "type": "string", "minLength": 3, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 3, "maxLength": 30 },
        "address": { "type": "string", "minLength": 1, "maxLength": 150 },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "ON_HOLD", "INACTIVE"]
        },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "name",
        "contactPerson",
        "email",
        "phone",
        "address",
        "status",
        "isSample",
        "createdAt",
        "updatedAt"
      ]
    },
    "PurchaseOrderDoc": {
      "title": "PurchaseOrderDoc",
      "description": "Purchase order record inside a tenant workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9\\-]+$"
        },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sup": { "type": "number" },
        "pid": { "type": "number" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "qty": { "type": "number" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" },
        "od": { "type": "string", "minLength": 10, "maxLength": 10 },
        "ex": { "type": "string", "minLength": 10, "maxLength": 10 },
        "rc": { "type": "string", "maxLength": 10 },
        "st": {
          "type": "string",
          "enum": ["pending", "received", "cancelled"]
        },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "sup",
        "pid",
        "productName",
        "qty",
        "unitPrice",
        "total",
        "od",
        "ex",
        "rc",
        "st",
        "isSample",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryTransactionDoc": {
      "title": "InventoryTransactionDoc",
      "description": "Immutable stock movement & ledger transaction entry inside a tenant workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pid": { "type": "number" },
        "productId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10 },
        "type": {
          "type": "string",
          "enum": ["IN", "OUT", "ADJUST"]
        },
        "transactionType": {
          "type": "string",
          "enum": ["PURCHASE", "SALE", "ADJUST"]
        },
        "qty": { "type": "number" },
        "quantity": { "type": "number" },
        "resultingStock": { "type": "number" },
        "note": { "type": "string", "minLength": 1, "maxLength": 120 },
        "relatedOrderId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "actorEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "pid",
        "productId",
        "productName",
        "date",
        "type",
        "transactionType",
        "qty",
        "quantity",
        "resultingStock",
        "note",
        "relatedOrderId",
        "actorEmail",
        "isSample",
        "createdAt"
      ]
    },
    "ForecastDoc": {
      "title": "ForecastDoc",
      "description": "Demand forecast record and historical demand series per product.",
      "type": "object",
      "properties": {
        "productId": { "type": "number" },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": { "type": "string", "minLength": 3, "maxLength": 20 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "forecastPeriod": { "type": "string", "minLength": 1, "maxLength": 30 },
        "windowDays": { "type": "number" },
        "historySeries": { "type": "array" },
        "predictedDailyDemand": { "type": "number" },
        "projectedPeriodTotal": { "type": "number" },
        "method": { "type": "string", "minLength": 1, "maxLength": 60 },
        "maeMean": { "type": "number" },
        "maeNaive": { "type": "number" },
        "isSample": { "type": "boolean" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "productId",
        "tenantId",
        "sku",
        "productName",
        "forecastPeriod",
        "windowDays",
        "historySeries",
        "predictedDailyDemand",
        "projectedPeriodTotal",
        "method",
        "maeMean",
        "maeNaive",
        "isSample",
        "generatedAt"
      ]
    },
    "NotificationDoc": {
      "title": "NotificationDoc",
      "description": "Real-time alert notification for stockouts, low stock, or PO events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "type": "string",
          "enum": ["LOW_STOCK", "OUT_OF_STOCK", "PO_UPDATE", "SYSTEM"]
        },
        "relatedRecordId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "userId",
        "message",
        "type",
        "relatedRecordId",
        "read",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReportDoc": {
      "title": "ReportDoc",
      "description": "Saved stakeholder report metadata and summary metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportType": {
          "type": "string",
          "enum": ["CSV_RECOMMENDATIONS", "JSON_EXECUTIVE_SUMMARY"]
        },
        "dateRange": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "totalProducts": { "type": "number" },
        "inventoryValue": { "type": "number" },
        "belowRopCount": { "type": "number" },
        "generatedBy": { "type": "string", "minLength": 3, "maxLength": 120 },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "reportType",
        "dateRange",
        "summary",
        "totalProducts",
        "inventoryValue",
        "belowRopCount",
        "generatedBy",
        "generatedAt"
      ]
    },
    "AuditLogDoc": {
      "title": "AuditLogDoc",
      "description": "Immutable security and administrative audit log record.",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "k": { "type": "string", "minLength": 1, "maxLength": 40 },
        "m": { "type": "string", "minLength": 1, "maxLength": 200 },
        "d": { "type": "string", "minLength": 10, "maxLength": 10 },
        "actorEmail": { "type": "string", "minLength": 3, "maxLength": 120 },
        "actorRole": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "OPS_MANAGER", "INVENTORY_ANALYST", "AUDITOR"]
        },
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARN", "CRITICAL"]
        },
        "n": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tenantId",
        "k",
        "m",
        "d",
        "actorEmail",
        "actorRole",
        "severity",
        "n",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminDoc" },
      "description": "Trusted admin lookup collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfileDoc" },
      "description": "Private user profiles with role and active tenant."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/ProductDoc" },
      "description": "Top-level products collection where each document ID is the unique productId (e.g. PROD001)."
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/TenantWorkspaceDoc" },
      "description": "Multi-tenant workspaces."
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": { "$ref": "#/entities/ProductDoc" },
      "description": "Products in a tenant workspace."
    },
    "/tenants/{tenantId}/inventory/{productId}": {
      "schema": { "$ref": "#/entities/InventoryDoc" },
      "description": "Real-time inventory stock records per product."
    },
    "/tenants/{tenantId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/SupplierDoc" },
      "description": "Suppliers in a tenant workspace."
    },
    "/tenants/{tenantId}/purchaseOrders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrderDoc" },
      "description": "Supplier purchase orders in a tenant workspace."
    },
    "/tenants/{tenantId}/inventoryTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/InventoryTransactionDoc" },
      "description": "Inventory ledger transactions in a tenant workspace."
    },
    "/tenants/{tenantId}/forecasts/{productId}": {
      "schema": { "$ref": "#/entities/ForecastDoc" },
      "description": "Demand forecasts and historical demand inputs per product."
    },
    "/tenants/{tenantId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationDoc" },
      "description": "Stock and order notifications in a tenant workspace."
    },
    "/tenants/{tenantId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReportDoc" },
      "description": "Saved stakeholder reports in a tenant workspace."
    },
    "/tenants/{tenantId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogDoc" },
      "description": "Security and activity audit logs in a tenant workspace."
    }
  }
}
